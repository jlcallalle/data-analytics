{"kind":"textbox","id":"sh/nmh4bep8","slideIndex":0,"position":{"left":50,"top":337,"width":355,"height":240},"text":"Un modelo relacional organiza los registros del centro y vincula a cada paciente con su atención y sus registros económicos.","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#24374A","alignment":"left"}}
