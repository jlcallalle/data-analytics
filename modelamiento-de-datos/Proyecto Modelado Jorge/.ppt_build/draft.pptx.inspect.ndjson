{"kind":"textbox","id":"sh/8zy5kj6d","slideIndex":0,"position":{"left":864,"top":337,"width":355,"height":280},"text":"Organizar las entidades y sus relaciones.\n\nProteger la integridad de los registros.\n\nFacilitar consultas de atención y facturación.","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#24374A","alignment":"left"}}
